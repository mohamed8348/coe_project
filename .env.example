# ============================================================
# Environment Variables — Copy to .env and fill values
# ============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_secret_key_32chars

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_bugs
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_bugs

# ERP Base URL (used in generated Selenium/Playwright scripts)
ERP_BASE_URL=http://localhost:8069
ERP_ADMIN_USER=admin
ERP_ADMIN_PASSWORD=admin

# Sentence Transformers model (set to 'tfidf' to use fallback offline mode)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index storage path
FAISS_INDEX_PATH=data/faiss_index

# Data directories
RAW_DATA_DIR=data/raw
CLEANED_DATA_DIR=data/cleaned
OUTPUT_DIR=data/output

# Approval thresholds
AUTO_APPROVE_BELOW_RISK=LOW
CONFIDENCE_THRESHOLD=0.35

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
